# ===========================================
# AlMulhim Travel - Backend Environment Variables
# Copy this file to .env and fill in your values
# ===========================================

# Database
ConnectionStrings__DefaultConnection=Server=localhost;Database=AlmulhemTravel;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true

# JWT Authentication
JwtSettings__SecretKey=YourSuperSecureJWTSecretKeyHere_MinimumLength32Characters!
JwtSettings__Issuer=AlmulhemTravelAPI
JwtSettings__Audience=AlmulhemTravelClient
JwtSettings__ExpirationInDays=7
JwtSettings__RefreshTokenExpirationInDays=30

# CORS - Comma separated origins
CorsSettings__AllowedOrigins__0=http://localhost:5173
CorsSettings__AllowedOrigins__1=http://localhost:3000
CorsSettings__AllowedOrigins__2=https://almulhemtravel.com

# Amadeus API (https://developers.amadeus.com)
AmadeusSettings__ApiKey=YOUR_AMADEUS_API_KEY
AmadeusSettings__ApiSecret=YOUR_AMADEUS_API_SECRET
AmadeusSettings__BaseUrl=https://test.api.amadeus.com

# RapidAPI (https://rapidapi.com)
RapidApiSettings__ApiKey=YOUR_RAPIDAPI_KEY
RapidApiSettings__BookingHost=booking-com15.p.rapidapi.com
RapidApiSettings__TripadvisorHost=tripadvisor16.p.rapidapi.com

# Email Service (SendGrid)
# EmailSettings__ApiKey=YOUR_SENDGRID_API_KEY
# EmailSettings__FromEmail=noreply@almulhemtravel.com
# EmailSettings__FromName=AlMulhim Travel

# Payment Gateway (Stripe)
# StripeSettings__SecretKey=sk_test_xxx
# StripeSettings__PublishableKey=pk_test_xxx
# StripeSettings__WebhookSecret=whsec_xxx
